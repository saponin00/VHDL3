  <vhdl appearance="logisim_evolution" name="rs_latch_vhdl">library ieee;
use ieee.std_logic_1164.all;

entity rs_latch_vhdl is
    port (r, s : in std_logic; q, nq : out std_logic);
end entity rs_latch_vhdl;

architecture rtl of rs_latch_vhdl is
begin
    process(r, s)
    begin
        if r = '1' then
            q &lt;= '0';
        elsif s = '1' then
            q &lt;= '1';
        end if;

        if s = '1' then
            nq &lt;= '0';
        elsif r = '1' then
            nq &lt;= '1';
        end if;
    end process;
end architecture rtl;
</vhdl>
  <vhdl appearance="logisim_evolution" name="d_latch_vhdl">library ieee;
use ieee.std_logic_1164.all;

entity d_latch_vhdl is
    port (d, en : in std_logic; q, nq : out std_logic);
end entity d_latch_vhdl;

architecture rtl of d_latch_vhdl is
    signal q_i : std_logic;
begin
    process(d, en)
    begin
        if en = '1' then
            q_i &lt;= d;
        end if;
    end process;
    q &lt;= q_i;
    nq &lt;= not q_i;
end architecture rtl;
</vhdl>
  <vhdl appearance="logisim_evolution" name="d_flipflop_vhdl">library ieee;
use ieee.std_logic_1164.all;

entity d_flipflop_vhdl is
    port (d, clk : in std_logic; q, nq : out std_logic);
end entity d_flipflop_vhdl;

architecture rtl of d_flipflop_vhdl is
    signal q_i : std_logic;
begin
    process(clk)
    begin
        if rising_edge(clk) then
            q_i &lt;= d;
        end if;
    end process;
    q &lt;= q_i;
    nq &lt;= not q_i;
end architecture rtl;
</vhdl>
  <vhdl appearance="logisim_evolution" name="jk_flipflop_vhdl">library ieee;
use ieee.std_logic_1164.all;

entity jk_flipflop_vhdl is
    port (j, k, clk, clr_n : in std_logic; q, nq : out std_logic);
end entity jk_flipflop_vhdl;

architecture rtl of jk_flipflop_vhdl is
    signal q_i : std_logic;
begin
    process(clk, clr_n)
    begin
        if clr_n = '0' then
            q_i &lt;= '0';
        elsif rising_edge(clk) then
            if j = '0' and k = '1' then
                q_i &lt;= '0';
            elsif j = '1' and k = '0' then
                q_i &lt;= '1';
            elsif j = '1' and k = '1' then
                q_i &lt;= not q_i;
            end if;
        end if;
    end process;
    q &lt;= q_i;
    nq &lt;= not q_i;
end architecture rtl;
</vhdl>
  <vhdl appearance="logisim_evolution" name="dff_async_vhdl">library ieee;
use ieee.std_logic_1164.all;

entity dff_async_vhdl is
    port (d, clk, set, clr : in std_logic; q, nq : out std_logic);
end entity dff_async_vhdl;

architecture rtl of dff_async_vhdl is
    signal q_i : std_logic;
begin
    process(clk, set, clr)
    begin
        if clr = '1' then
            q_i &lt;= '0';
        elsif set = '1' then
            q_i &lt;= '1';
        elsif rising_edge(clk) then
            q_i &lt;= d;
        end if;
    end process;
    q &lt;= q_i;
    nq &lt;= not q_i;
end architecture rtl;
</vhdl>
</project>
